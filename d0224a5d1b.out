}

.ae-contractors-search li div a, .ae-contractors-search li h4 a {
    font-size: .85rem;
    padding-bottom: 0px;
}

.ae-contractors-search li .col-md-4 {
    padding: 0px;
}

.search-results.ae-contractors-search ul.search-result-list li {
    margin-bottom: 0px !important;
}

.search-results.ae-contractors-search ul li div.col-sm-12, 
.search-results.ae-contractors-search ul li div.col-sm-8, 
.search-results.ae-contractors-search ul li div.col-sm-6, 
.search-results.ae-contractors-search ul li div.col-sm-4 {
    padding: 10px 5px;
}

.search-results .search-result-list li:hover {
    border-width: 1px;
    border: 1px dotted #3b241b !important;
}

@media (max-width: 600px) {
    .tab-company-list-header .col-md-4 {
