/* AE Roll Up Page Styles */

.page-list.horizontal-card ul.items li.item .image-container a img {
    width: 100%;
    height: auto;
}
.page-list.horizontal-card ul.items li.item .content-container {
    padding-left: 20px;
}
.page-list.horizontal-card ul.items li.item .content-container h3 {
    margin-bottom: 20px;
   margin-top: 0px;
}
.page-list.horizontal-card ul.items li.item .image-container a {
    border: none;
    text-decoration: none;
}
.page-list.horizontal-card ul.items li.item {
    padding: 10px 10px 0 6px;
    margin-top: 5px;
}
.page-list.horizontal-card ul.items li.item .content-container h3 a {
    text-decoration: none;
    border: none;
}
.page-list.horizontal-card ul {
    padding-left: 0px;
    margin-left: 0px;
}
@media (max-width: 991px) {
    .page-list.horizontal-card ul.items li.item .content-container {
        padding-left: 0;
        padding-bottom: 10px;
    }
}

.component.page-list.horizontal-card .image-container a img {
  width: 90%;
}

.component.page-list.horizontal-card .image-container a {
  border: none;
}

.component.page-list.horizontal-card .content-container h3 a {
  border: none;
}

.component.page-list.horizontal-card .content-container h3 a:hover {
    border-bottom: solid 1px;
    color: #22254e;
}

.page-list .item {
border-bottom-color: #cccccc;
}

/* AE Offerings Apply Call Outs */

.row .simple-callout>.component-content  {
  height: 100%;
  padding-bottom: 40px;
}

.simple-callout .grid8of12 .field-promolink a {
  position: absolute;
  bottom: 20px;
}

.simple-callout {
  height: 100%;
}

/* Did You Know Call Outs */

.promo.didYouKnow .component-content {
  margin-right: 1rem;
}


/* Contractor List */

.search-box .component-content .twitter-typeahead {
    margin: 0 5px 0 0;
}

.search-box {
    padding-right: 0px;
}

.aeBodyText .faq-accordion ul.search-result-list {
    margin-left: 0;
    margin-top: 0 !important;
    padding-top: 0 !important;
}

.faq-accordion .tab-company-list-header {
