    <button id="scrollTop" aria-label="back to top" style="display: inline-block;"></button>

    <script>
        /** Scroll Top **/
        $(function () {
            $(window).scroll(function () {
                if ($(this).scrollTop() > 200) {
                    $('#scrollTop').fadeIn();
                } else {
                    $('#scrollTop').fadeOut();

                }
            });


            // scroll body to 0px on click
            $('button#scrollTop').click(function () {
                $('body,html').animate({
                    scrollTop: 0
                }, 800);
                return false;
            });
        });</script>
  
