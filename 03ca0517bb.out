<script>
    (function () {
        const header = document.querySelector('.js-site-header');
        if (!header) return;

        // Find the mega-menu nav regardless of nesting
        const getNav = () =>
            header.matches('nav.mega-menu') ? header :
                header.querySelector('nav.mega-menu') ||
                document.querySelector('nav.mega-menu');

        const nav = getNav();
        if (!nav) return;

        const collapse = nav.querySelector('.navbar-collapse');

        const setHeaderVar = () => {
            // Measure header height (sticky unit), excluding any fixed-positioned mobile panel
            const h = Math.ceil(header.getBoundingClientRect().height);
            document.documentElement.style.setProperty('--site-header-h', h + 'px');
        };

        const closeAllDropdowns = () => {
            const openDrops = nav.querySelectorAll('.dropdown.show');
            openDrops.forEach(d => {
                d.classList.remove('show');

                const menu = d.querySelector('.dropdown-menu');
                if (menu) menu.classList.remove('show');

                const toggle = d.querySelector('[data-toggle="dropdown"], [data-bs-toggle="dropdown"]');
                if (toggle) toggle.setAttribute('aria-expanded', 'false');
            });
        };

        // Initial set
        setHeaderVar();

        // Update on resize/layout changes
        window.addEventListener('resize', setHeaderVar, { passive: true });

        if ('ResizeObserver' in window) {
            const ro = new ResizeObserver(setHeaderVar);
            ro.observe(header);
        }


        // Bootstrap collapse changes header layout; update var + reset dropdown states when closing
        if (collapse) {
            collapse.addEventListener('show.bs.collapse', () => {
                // Ensure header height is up-to-date before positioning the panel
                setHeaderVar();
                // Close any open mega dropdowns when opening mobile nav
                closeAllDropdowns();
            });

            collapse.addEventListener('shown.bs.collapse', setHeaderVar);

            collapse.addEventListener('hide.bs.collapse', () => {
                // On close, clear any dropdown state so the next open is clean
                closeAllDropdowns();
            });

            collapse.addEventListener('hidden.bs.collapse', () => {
                closeAllDropdowns();
                setHeaderVar();
            });
        }

        // Also reset dropdowns when switching to desktop (prevents stuck mobile state)
        const mq = window.matchMedia('(min-width: 768px)');
        const onMq = () => {
            if (mq.matches) {
                closeAllDropdowns();
                setHeaderVar();
            }
        };
        if (mq.addEventListener) mq.addEventListener('change', onMq);
        else mq.addListener(onMq);


    })();
</script>

</nav>

