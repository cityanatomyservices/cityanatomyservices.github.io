        $(function () {
            var $main = $('#site-main');
            if (!$main.length) return;

            // Treat "/" (and empty) as homepage; everything else is a subpage
            var path = (window.location.pathname || '').replace(/\/+$/, ''); // trim trailing slashes
            var isHome = (path === '');

            if (isHome) {
                $main.addClass('homepage').removeClass('subpage');
            } else {
                $main.addClass('subpage').removeClass('homepage');
            }
        });
    </script> </body> </html>
