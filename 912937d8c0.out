<script>
	jQuery(function($) {
        $('.e-n-tab-title').on('click', function() {
            var tableID = $(this).attr('aria-controls'); // Get the tab content ID
            
            // Target the specific table inside that tab
            var tableElement = $('#' + tableID + ' .tablepress'); 
            
            // Initialize DataTables on the targeted table
            if (!$.fn.DataTable.isDataTable(tableElement)) {
                var table = new DataTable(tableElement, {
                    autoWidth: false, // Disable auto width to enforce 100%
                    scrollX: true     // Enable horizontal scrolling in case of overflow
                });
            } else {
                var table = $(tableElement).DataTable(); // Access already initialized table
            }
            
            // Adjust columns and redraw the table
            table.columns.adjust().draw();
        });
    });
</script>


